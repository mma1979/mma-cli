<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>Preview</LangVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mma</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <FileVersion>10.0.0</FileVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <AssemblyName>mma-cli</AssemblyName>
    <AssemblyVersion>10.0.0</AssemblyVersion>
    <Version>10.0.0-preview.3</Version>
    <PackageVersion>10.0.0-preview.3</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>mma3.png</PackageIcon>
    <PackageProjectUrl>https://github.com/mma1979/mma-cli</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="114.1.0" />
    <PackageReference Include="Sharprompt" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="nupkg\" />
    <Folder Include="UI\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="UI\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="docs\**\*" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mma.Cli.Shared\Mma.Cli.Shared.csproj" />
  </ItemGroup>
</Project>