# Local development
# The Vite dev server proxies /api and /openapi to http://127.0.0.1:5180.
# No runtime configuration is required for the packaged app.

# Optional: force the initial theme ("light" | "dark").
# VITE_THEME=dark

# Playwright (set by playwright.config.ts automatically when unset).
# MMA_E2E_ROOT=
